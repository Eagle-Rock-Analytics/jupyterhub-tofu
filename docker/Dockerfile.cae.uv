# CAE JupyterHub Custom Image with uv
# Extends py-rocket-base with climakitae as the DEFAULT Python environment
#
# Features:
# - VSCode, RStudio, Desktop (from py-rocket-base)
# - climakitae + full Jupyter stack as default kernel
# - Uses uv for fast, deterministic package installation
# - Single virtual environment replaces base notebook env
#
# Build:
#   docker build -f Dockerfile.cae.uv -t cae-notebook:test .
#
# Test locally:
#   docker run -p 8888:8888 cae-notebook:test

ARG BASE_TAG=latest
ARG PACKAGE_REFRESH=2026.08.17
FROM ghcr.io/nmfs-opensci/py-rocket-base:${BASE_TAG}

USER root

ARG BASE_TAG
ARG PACKAGE_REFRESH

# Install uv for fast Python package management
RUN curl -LsSf https://github.com/astral-sh/uv/releases/latest/download/uv-x86_64-unknown-linux-gnu.tar.gz \
    | tar -xz -C /usr/local/bin --strip-components=1 && \
    uv --version

# Install awscli v2 for S3 access
RUN curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "/tmp/awscliv2.zip" && \
    unzip /tmp/awscliv2.zip -d /tmp && \
    /tmp/aws/install && \
    rm -rf /tmp/aws /tmp/awscliv2.zip

# Install rclone for cloud storage access
RUN curl -sSL https://rclone.org/install.sh | bash

# =============================================================================
# Create Python environment directly in /srv/conda/envs/notebook
# =============================================================================
# By creating the venv directly where it's used, we avoid symlink issues
WORKDIR /srv/conda/envs/notebook

# code-server is bundled in the base notebook environment. Preserve its Node
# application before replacing that environment with the Python 3.12 venv.
RUN cp -a /srv/conda/envs/notebook/share/code-server /opt/code-server && \
    mkdir -p /opt/node/bin /opt/node/lib && \
    cp -a /srv/conda/envs/notebook/bin/node /opt/node/bin/ && \
    cp -L \
        /srv/conda/envs/notebook/lib/libnode.so.115 \
        /srv/conda/envs/notebook/lib/libz.so.1 \
        /srv/conda/envs/notebook/lib/libuv.so.1 \
        /srv/conda/envs/notebook/lib/libcrypto.so.3 \
        /srv/conda/envs/notebook/lib/libssl.so.3 \
        /srv/conda/envs/notebook/lib/libicui18n.so.78 \
        /srv/conda/envs/notebook/lib/libicuuc.so.78 \
        /srv/conda/envs/notebook/lib/libicudata.so.78 \
        /srv/conda/envs/notebook/lib/libstdc++.so.6 \
        /srv/conda/envs/notebook/lib/libgcc_s.so.1 \
        /opt/node/lib/

# Create virtual environment with Python 3.12
RUN echo "Creating Python 3.12 environment: ${PACKAGE_REFRESH}" && \
    uv venv --clear --force --python 3.12 /srv/conda/envs/notebook

# Give the venv a conda-meta/history stub so the base image's `conda` still
# recognizes /srv/conda/envs/notebook as an environment (falls back to listing
# packages via site-packages metadata) instead of raising
# DirectoryNotACondaEnvironmentError on `conda list`/`conda info`.
RUN mkdir -p /srv/conda/envs/notebook/conda-meta && \
    touch /srv/conda/envs/notebook/conda-meta/history

RUN printf '%s\n' \
    '#!/bin/sh' \
    'exec /opt/node/bin/node /opt/code-server/out/node/entry.js --extensions-dir /srv/conda/envs/notebook/share/code-server/extensions "$@"' \
    > /srv/conda/envs/notebook/bin/code-server && \
    chmod 755 /srv/conda/envs/notebook/bin/code-server && \
    mkdir -p /srv/conda/envs/notebook/share/code-server/extensions && \
    chown ${NB_USER}:${NB_USER} /srv/conda/envs/notebook/share/code-server/extensions

# Install all packages needed for JupyterHub with climakitae
# climakitae brings xarray, dask, pandas, numpy, and scientific stack
RUN echo "Refreshing Python dependencies: ${PACKAGE_REFRESH}" && \
    uv pip install --upgrade \
    --python /srv/conda/envs/notebook/bin/python \
    climakitae==1.5.7 \
    cartopy \
    panel \
    hvplot \
    folium \
    mapclassify \
    geoviews \
    bokeh \
    plotly \
    pytest \
    black \
    seaborn \
    jupyterhub \
    jupyterlab>=4.5.8 \
    jupyter-server-proxy \
    jupyter-resource-usage \
    jupyter-vscode-proxy \
    jupyter-rsession-proxy \
    jupyterlab-git \
    jupyterlab-lsp \
    nbgitpuller \
    ipykernel \
    ipywidgets>=8 \
    dask-gateway \
    dask-labextension \
    jupytext \
    ipdb

RUN printf '%s\n' \
    'import importlib' \
    'import site' \
    'import sys' \
    '' \
    'user_site = site.getusersitepackages()' \
    'site.addsitedir(user_site)' \
    '' \
    'sys.path[:] = [path for path in sys.path if path != user_site]' \
    'sys.path.insert(1 if sys.path and sys.path[0] == "" else 0, user_site)' \
    '' \
    'try:' \
    '    importlib.import_module("usercustomize")' \
    'except ImportError:' \
    '    pass' \
    > /srv/conda/envs/notebook/lib/python3.12/site-packages/sitecustomize.py

# Register the kernel with proper display name
RUN /srv/conda/envs/notebook/bin/python -m ipykernel install \
    --prefix=/srv/conda/envs/notebook \
    --name python3 \
    --display-name "Python 3 (climakitae)"

# Create 'cae' symlink for backward compatibility
RUN ln -s /srv/conda/envs/notebook /srv/conda/envs/cae

# Configure pip to prefer user installs and upgrade packages
# This ensures pip install --user works even when packages exist in base environment
RUN mkdir -p /tmp/pip && \
    echo "[global]" > /tmp/pip_config.ini && \
    echo "upgrade-strategy = eager" >> /tmp/pip_config.ini && \
    echo "no-input = True" >> /tmp/pip_config.ini

# Verify installation by checking key packages can be imported
RUN /srv/conda/envs/notebook/bin/python -c "import climakitae; import xarray; import dask; import jupyterlab; print('✓ All core packages installed')"

# Set notebook env as default for system shell
ENV PATH=/srv/conda/envs/notebook/bin:$PATH
ENV CONDA_DEFAULT_ENV=notebook
ENV CONDA_PREFIX=/srv/conda/envs/notebook
# Have conda merge uv/pip-installed packages into `conda list` (shown as
# channel "pypi") so it reflects the same packages as `pip freeze`.
ENV CONDA_PIP_INTEROP_ENABLED=true

# Fix matplotlib config directory issue that hangs VSCode startup
# Create writable matplotlib cache directory
RUN mkdir -p /tmp/matplotlib && \
    chmod 777 /tmp/matplotlib && \
    mkdir -p ${HOME}/.config/matplotlib && \
    chmod 777 ${HOME}/.config/matplotlib

ENV MPLCONFIGDIR=/tmp/matplotlib
ENV MATPLOTLIBRC=/tmp/matplotlib

# Note: Keeping base image's default entrypoint for JupyterHub compatibility
# The base image will use jupyterhub-singleuser when deployed in JupyterHub
# For local testing: docker run -p 8888:8888 <image> jupyter lab --ip=0.0.0.0 --no-browser --allow-root

# Switch to user for JupyterHub
USER ${NB_USER}
WORKDIR /home/${NB_USER}

# Configure pip for user installations
# This ensures pip install --user works correctly even when packages exist in base environment
RUN mkdir -p ~/.pip && \
    echo "[global]" > ~/.pip/pip.conf && \
    echo "upgrade-strategy = eager" >> ~/.pip/pip.conf && \
    echo "no-input = True" >> ~/.pip/pip.conf

# Install code-server extensions as user
RUN install_extension() { \
        extension="$1"; \
        for attempt in 1 2 3; do \
            /srv/conda/envs/notebook/bin/code-server --install-extension "$extension" && return 0; \
            if [ "$attempt" -eq 3 ]; then return 1; fi; \
            sleep $((attempt * 5)); \
        done; \
    }; \
    install_extension aaron-bond.better-comments && \
    install_extension ms-python.black-formatter && \
    install_extension github.vscode-github-actions && \
    install_extension github.vscode-pull-request-github && \
    install_extension ms-python.pylint && \
    install_extension mechatroner.rainbow-csv && \
    install_extension amazonwebservices.aws-toolkit-vscode

# Add labels for tracking
LABEL maintainer="Cal-Adapt Analytics Engine development team"
LABEL description="py-rocket-base with climakitae (uv-based installation)"
LABEL base_image="ghcr.io/nmfs-opensci/py-rocket-base:${BASE_TAG}"
LABEL package_manager="uv"
LABEL package_refresh="${PACKAGE_REFRESH}"
LABEL features="climakitae,jupyter,dask,vscode,rstudio,desktop"
